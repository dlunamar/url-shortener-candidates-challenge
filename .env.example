# Application
NODE_ENV=development

# URL Shortener
# Use port 5173 for development, 3000 for production (docker)
PUBLIC_URL=http://localhost:5173

# Database (Prisma + SQLite)
# Relative sqlite paths resolve from libs/engine/prisma/ in every cwd
# (dev server, tests, CLI), so this value works everywhere locally.
DATABASE_URL="file:./dev.db"
# NOTE: the Prisma CLI only reads libs/engine/.env (same variable, same
# value). Copy this line there after `cp .env.example .env`.
